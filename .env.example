# 变量名模板（值绝不提交仓库 / 绝不发聊天）。平台 secrets 或本机 .env 自填。
DEEPSEEK_API_KEY=
RETRIEVER=deepseek
FAST_LLM=deepseek:deepseek-flash
SMART_LLM=deepseek:deepseek-flash
EMBEDDING=huggingface:all-MiniLM-L6-v2
HF_ENDPOINT=https://huggingface.co

# 所有者登录（公网版）
OWNER_USERNAME=vansinver
OWNER_PASSWORD=
JWT_SECRET=

# 持久化（Plan A：私有 HF dataset）
HF_TOKEN=
HF_DATASET_REPO=vansinver/info-radar-data

# 运行参数
DATA_DIR=/data
PORT=7860
PAGES_ORIGIN=https://vansinver.github.io
BUILD_SHA=
PY_GPTR=/app/backend/venv-gptr/bin/python
PY_STORM=/app/backend/venv-storm/bin/python
